# Copy to .env and fill in: cp .env.example .env
# .env is git-ignored. Never commit it.

# PostgreSQL (also used by docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/knowledgedrop
DB_USER=knowledgedrop
DB_PASSWORD=knowledgedrop

# Elasticsearch
ELASTICSEARCH_URIS=http://localhost:9200

# Embeddings: sentence-transformers service (KD-8). Dimension must match the index mapping.
EMBEDDING_BASE_URL=http://localhost:5000
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM: hosted API behind LlmClient (KD-8). Leave the key empty for local runs without ask.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash

