{
  "name": "harborline-analyst-portal",
  "private": true,
  "version": "0.1.0",
  "description": "Internal analyst portal for a fictional insurer, built on the knowledgeDrop service.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
