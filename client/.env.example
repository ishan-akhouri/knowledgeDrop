# Copy to client/.env and change every secret before using this anywhere shared.

# --- Shared Postgres (the one started by the root docker-compose.yml) ---
PG_HOST=host.docker.internal
PG_PORT=5432
PG_DB=knowledgedrop
PG_SUPERUSER=knowledgedrop
PG_SUPERUSER_PASSWORD=knowledgedrop

# --- PostgREST ---
# Password for the portal_authenticator login role that PostgREST connects as.
PORTAL_AUTHENTICATOR_PASSWORD=change-me-authenticator
# HS256 secret used to sign and verify login JWTs. Must be at least 32 characters.
PORTAL_JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# --- First admin account (created only if that username does not exist yet) ---
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=change-me-admin

# --- Ports ---
CLIENT_PORT=3000
POSTGREST_DEV_PORT=3001

# --- Where nginx (in Docker) reaches the knowledgeDrop service ---
KD_API_URL=http://host.docker.internal:8080

# --- Vite dev server targets (npm run dev) ---
KD_API_URL_DEV=http://localhost:8080
POSTGREST_URL_DEV=http://localhost:3001
